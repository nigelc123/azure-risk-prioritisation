# Secrets - never commit real credentials.
secrets/
python/.env

# Terraform state and plans can contain sensitive resource attributes/outputs.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/tfplan
terraform/*.tfplan
terraform/.terraform.lock.hcl

# Local data/output generated by scans and app runs.
data/prowler-output/
data/*.db
logs/

# Python
python/__pycache__/
*.pyc

# OS cruft
.DS_Store
